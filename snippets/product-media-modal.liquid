{% comment %}
  Product Media Modal
  Lightbox modal for product images
{% endcomment %}

<div class="product-media-modal modal" id="ProductModal-{{ section.id }}" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="product-media-modal__dialog" role="document">
    <div class="product-media-modal__content">
      <button
        type="button"
        class="product-media-modal__toggle"
        aria-label="Close modal"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      
      <div class="product-media-modal__media">
        <!-- Media content will be inserted here -->
      </div>
      
      <div class="product-media-modal__info">
        <h3 class="product-media-modal__title">{{ product.title }}</h3>
        <div class="product-media-modal__price">
          {% render 'price', product: product %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.product-media-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.9);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.product-media-modal.active {
  opacity: 1;
  visibility: visible;
}

.product-media-modal__dialog {
  position: relative;
  max-width: 90vw;
  max-height: 90vh;
  background: #1a1a1a;
  border-radius: 12px;
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.product-media-modal.active .product-media-modal__dialog {
  transform: scale(1);
}

.product-media-modal__content {
  position: relative;
  display: flex;
  flex-direction: column;
}

.product-media-modal__toggle {
  position: absolute;
  top: 1rem;
  right: 1rem;
  z-index: 10;
  background: rgba(26, 26, 26, 0.8);
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  cursor: pointer;
  transition: all 0.3s ease;
}

.product-media-modal__toggle:hover {
  background: rgba(212, 175, 55, 0.9);
  color: #1a1a1a;
}

.product-media-modal__media {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400px;
}

.product-media-modal__media img,
.product-media-modal__media video {
  max-width: 100%;
  max-height: 70vh;
  object-fit: contain;
  border-radius: 8px;
}

.product-media-modal__info {
  padding: 2rem;
  background: rgba(30, 58, 43, 0.3);
  border-top: 1px solid rgba(212, 175, 55, 0.2);
}

.product-media-modal__title {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  font-weight: 600;
  color: #D4AF37;
  margin-bottom: 1rem;
}

.product-media-modal__price {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.2rem;
  font-weight: 600;
  color: #ffffff;
}

/* Mobile adjustments */
@media (max-width: 768px) {
  .product-media-modal__dialog {
    max-width: 95vw;
    max-height: 95vh;
  }
  
  .product-media-modal__media {
    min-height: 300px;
  }
  
  .product-media-modal__media img,
  .product-media-modal__media video {
    max-height: 60vh;
  }
  
  .product-media-modal__info {
    padding: 1.5rem;
  }
  
  .product-media-modal__title {
    font-size: 1.25rem;
  }
}

/* Close modal when clicking outside */
.product-media-modal::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  cursor: pointer;
}

/* Prevent scrolling when modal is open */
.modal-open {
  overflow: hidden;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('ProductModal-{{ section.id }}');
  const closeButton = modal.querySelector('.product-media-modal__toggle');
  
  // Close modal function
  function closeModal() {
    modal.classList.remove('active');
    document.body.classList.remove('modal-open');
  }
  
  // Close modal on button click
  closeButton.addEventListener('click', closeModal);
  
  // Close modal on background click
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      closeModal();
    }
  });
  
  // Close modal on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('active')) {
      closeModal();
    }
  });
});
</script>