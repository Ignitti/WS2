{% comment %}
  Loading Spinner
  Displays animated loading indicator
{% endcomment %}

<svg
  aria-hidden="true"
  focusable="false"
  class="spinner"
  viewBox="0 0 66 66"
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
>
  <circle
    class="spinner__path"
    fill="none"
    stroke-width="6"
    cx="33"
    cy="33"
    r="30"
  ></circle>
</svg>

<style>
.spinner {
  animation: rotator 1.4s linear infinite;
}

@keyframes rotator {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(270deg);
  }
}

.spinner__path {
  stroke-dasharray: 187;
  stroke-dashoffset: 0;
  transform-origin: center;
  stroke: currentColor;
  animation: dash 1.4s ease-in-out infinite;
}

@keyframes dash {
  0% {
    stroke-dashoffset: 187;
  }
  50% {
    stroke-dashoffset: 46.75;
    transform: rotate(135deg);
  }
  100% {
    stroke-dashoffset: 187;
    transform: rotate(450deg);
  }
}

/* Color variations */
.spinner--light .spinner__path {
  stroke: #ffffff;
}

.spinner--primary .spinner__path {
  stroke: #D4AF37;
}

.spinner--dark .spinner__path {
  stroke: #1a1a1a;
}
</style>