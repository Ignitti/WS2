{% comment %}
  Renders a product card for recommendations
{% endcomment %}

{%- if card_product and card_product != empty -%}
  <div class="product-card">
    <a href="{{ card_product.url }}" class="product-card__link">
      {%- if card_product.featured_media -%}
        <div class="product-card__image">
          <img
            src="{{ card_product.featured_media | image_url: width: 400 }}"
            alt="{{ card_product.featured_media.alt | escape }}"
            loading="lazy"
            width="400"
            height="400"
          >
          {%- if show_secondary_image and card_product.media[1] -%}
            <img
              src="{{ card_product.media[1] | image_url: width: 400 }}"
              alt=""
              loading="lazy"
              width="400"
              height="400"
              class="product-card__image-hover"
            >
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="product-card__image product-card__image--placeholder">
          <img src="https://cdn.pixabay.com/photo/2017/02/05/12/31/candle-2042085_960_720.jpg" alt="Placeholder candle" loading="lazy">
        </div>
      {%- endif -%}
      
      <div class="product-card__info">
        <h3 class="product-card__title">{{ card_product.title | escape }}</h3>
        {%- if show_vendor and card_product.vendor != blank -%}
          <p class="product-card__vendor">{{ card_product.vendor }}</p>
        {%- endif -%}
        <div class="product-card__price">
          {%- if card_product.compare_at_price > card_product.price -%}
            <span class="price price--on-sale">
              {{ card_product.price | money }}
            </span>
            <span class="price price--compare">
              {{ card_product.compare_at_price | money }}
            </span>
          {%- else -%}
            <span class="price">
              {{ card_product.price | money }}
            </span>
          {%- endif -%}
        </div>
      </div>
      
      {%- unless card_product.available -%}
        <div class="product-card__badge">
          {{ 'products.product.sold_out' | t }}
        </div>
      {%- else -%}
        {%- if card_product.compare_at_price > card_product.price -%}
          <div class="product-card__badge product-card__badge--sale">
            {{ 'products.product.on_sale' | t }}
          </div>
        {%- endif -%}
      {%- endunless -%}
    </a>
  </div>
{%- endif -%}

<style>
.product-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
  position: relative;
}

.product-card:hover {
  transform: translateY(-5px);
  border-color: rgba(212, 175, 55, 0.3);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.product-card__link {
  display: block;
  text-decoration: none;
  color: inherit;
}

.product-card__image {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
}

.product-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s ease;
}

.product-card__image-hover {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.product-card:hover .product-card__image-hover {
  opacity: 1;
}

.product-card__image--placeholder {
  background: rgba(30, 58, 43, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-card__info {
  padding: 1.5rem;
}

.product-card__title {
  font-family: 'Montserrat', sans-serif;
  font-size: 1rem;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 0.5rem;
  line-height: 1.4;
}

.product-card__vendor {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.875rem;
  color: #cccccc;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.product-card__price {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.price {
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  color: #D4AF37;
}

.price--on-sale {
  color: #D4AF37;
}

.price--compare {
  color: #cccccc;
  text-decoration: line-through;
  font-weight: 400;
}

.product-card__badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: rgba(26, 26, 26, 0.9);
  color: #ffffff;
  padding: 0.25rem 0.75rem;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.product-card__badge--sale {
  background: #D4AF37;
  color: #1a1a1a;
}
</style>