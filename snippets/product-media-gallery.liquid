{% comment %}
  Product Media Gallery
  Displays product images and videos
{% endcomment %}

<div class="product__media-gallery">
  {%- if product.media.size > 0 -%}
    <div class="product__media-list">
      {%- for media in product.media -%}
        <div class="product__media-item{% if forloop.first %} active{% endif %}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <img
                src="{{ media | image_url: width: 800 }}"
                alt="{{ media.alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="800"
                height="800"
                class="product__media-image"
              >
            {%- when 'video' -%}
              <video
                controls
                width="800"
                height="800"
                class="product__media-video"
              >
                <source src="{{ media.sources[0].url }}" type="{{ media.sources[0].mime_type }}">
                Your browser does not support the video tag.
              </video>
            {%- when 'external_video' -%}
              <div class="product__media-external-video">
                {{ media | external_video_tag }}
              </div>
            {%- when 'model' -%}
              <div class="product__media-model">
                {{ media | model_viewer_tag }}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    
    {%- if product.media.size > 1 -%}
      <div class="product__media-thumbnails">
        {%- for media in product.media -%}
          <button class="product__media-thumbnail{% if forloop.first %} active{% endif %}" data-media-index="{{ forloop.index0 }}">
            {%- if media.media_type == 'image' -%}
              <img
                src="{{ media | image_url: width: 100 }}"
                alt="{{ media.alt | escape }}"
                loading="lazy"
                width="100"
                height="100"
              >
            {%- else -%}
              <div class="media-thumbnail-placeholder">{{ media.media_type }}</div>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="product__media-placeholder">
      <img 
        src="https://cdn.pixabay.com/photo/2017/02/05/12/31/candle-2042085_960_720.jpg" 
        alt="Placeholder candle" 
        loading="eager"
        width="800"
        height="800"
      >
    </div>
  {%- endif -%}
</div>

<style>
.product__media-gallery {
  width: 100%;
}

.product__media-item {
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  background: rgba(30, 58, 43, 0.3);
}

.product__media-item:not(.active) {
  display: none;
}

.product__media-image,
.product__media-video {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.product__media-placeholder {
  aspect-ratio: 1;
  background: rgba(30, 58, 43, 0.3);
  border-radius: 12px;
  overflow: hidden;
}

.product__media-placeholder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product__media-thumbnails {
  display: flex;
  gap: 0.5rem;
  margin-top: 1rem;
  overflow-x: auto;
}

.product__media-thumbnail {
  flex-shrink: 0;
  width: 80px;
  height: 80px;
  border: 2px solid transparent;
  border-radius: 8px;
  overflow: hidden;
  background: none;
  cursor: pointer;
  transition: border-color 0.3s ease;
}

.product__media-thumbnail.active {
  border-color: #D4AF37;
}

.product__media-thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.media-thumbnail-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  color: #cccccc;
  font-size: 0.75rem;
  font-family: 'Montserrat', sans-serif;
}
</style>