[
  {
    "name": "theme_info",
    "theme_name": "Ignitti",
    "theme_version": "1.0.0",
    "theme_author": "Ignitti Team",
    "theme_documentation_url": "https://ignitti.com/help",
    "theme_support_url": "https://ignitti.com/support"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Background Colors"
      },
      {
        "type": "color",
        "id": "color_background_primary",
        "label": "Primary background",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_background_secondary",
        "label": "Secondary background",
        "default": "#1E3A2B"
      },
      {
        "type": "header",
        "content": "Text Colors"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "label": "Primary text",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Secondary text",
        "default": "#cccccc"
      },
      {
        "type": "header",
        "content": "Accent Colors"
      },
      {
        "type": "color",
        "id": "color_accent_primary",
        "label": "Primary accent (Gold)",
        "default": "#D4AF37"
      },
      {
        "type": "color",
        "id": "color_accent_secondary",
        "label": "Secondary accent",
        "default": "#B8941F"
      }
    ]
  },
  {
    "name": "Product Grid",
    "settings": [
      {
        "type": "range",
        "id": "products_per_row_desktop",
        "min": 2,
        "max": 5,
        "step": 1,
        "label": "Products per row (desktop)",
        "default": 4
      },
      {
        "type": "range",
        "id": "products_per_row_tablet",
        "min": 2,
        "max": 4,
        "step": 1,
        "label": "Products per row (tablet)",
        "default": 3
      },
      {
        "type": "range",
        "id": "products_per_row_mobile",
        "min": 1,
        "max": 3,
        "step": 1,
        "label": "Products per row (mobile)",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "show_product_vendor",
        "label": "Show product vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_product_rating",
        "label": "Show product rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quick_view",
        "label": "Enable quick view",
        "default": true
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "montserrat_n4",
        "label": "Heading font",
        "info": "Used for headings and navigation"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "montserrat_n4",
        "label": "Body font",
        "info": "Used for body text and general content"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "default": "playfair_display_n4",
        "label": "Accent font",
        "info": "Used for special callouts and subtitles"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "container_max_width",
        "min": 1200,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "label": "Container max width",
        "default": 1400
      },
      {
        "type": "checkbox",
        "id": "enable_rounded_corners",
        "label": "Enable rounded corners",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_predictive_search",
        "label": "Enable predictive search",
        "default": true
      },
      {
        "type": "range",
        "id": "search_results_limit",
        "min": 4,
        "max": 20,
        "step": 2,
        "label": "Number of search results",
        "default": 10
      }
    ]
  },
  {
    "name": "Newsletter",
    "settings": [
      {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Newsletter heading",
        "default": "Join the Elite"
      },
      {
        "type": "textarea",
        "id": "newsletter_description",
        "label": "Newsletter description",
        "default": "Be the first to discover new fragrances, exclusive releases, and insider stories from the world of Ignitti."
      },
      {
        "type": "text",
        "id": "newsletter_button_text",
        "label": "Button text",
        "default": "Subscribe"
      }
    ]
  }
]