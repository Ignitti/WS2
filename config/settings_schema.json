[
  {
    "name": "theme_info",
    "theme_name": "Ignitti",
    "theme_version": "1.0.0",
    "theme_author": "Ignitti Team",
    "theme_documentation_url": "https://ignitti.com/help",
    "theme_support_url": "https://ignitti.com/support"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32x32px"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "montserrat_n4",
        "label": "Heading font",
        "info": "Used for headings and navigation"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "montserrat_n4",
        "label": "Body font",
        "info": "Used for body text and general content"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "default": "playfair_display_n4",
        "label": "Accent font",
        "info": "Used for special callouts and subtitles"
      },
      {
        "type": "range",
        "id": "base_font_size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Base font size",
        "default": 16
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Background Colors"
      },
      {
        "type": "color",
        "id": "color_background_primary",
        "label": "Primary background",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_background_secondary",
        "label": "Secondary background",
        "default": "#1E3A2B"
      },
      {
        "type": "header",
        "content": "Text Colors"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "label": "Primary text",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Secondary text",
        "default": "#cccccc"
      },
      {
        "type": "header",
        "content": "Accent Colors"
      },
      {
        "type": "color",
        "id": "color_accent_primary",
        "label": "Primary accent (Gold)",
        "default": "#D4AF37"
      },
      {
        "type": "color",
        "id": "color_accent_secondary",
        "label": "Secondary accent",
        "default": "#B8941F"
      },
      {
        "type": "header",
        "content": "Button Colors"
      },
      {
        "type": "color",
        "id": "color_button_primary",
        "label": "Primary button background",
        "default": "#D4AF37"
      },
      {
        "type": "color",
        "id": "color_button_primary_text",
        "label": "Primary button text",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_button_secondary",
        "label": "Secondary button background",
        "default": "rgba(255, 255, 255, 0.1)"
      },
      {
        "type": "color",
        "id": "color_button_secondary_text",
        "label": "Secondary button text",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "container_max_width",
        "min": 1200,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "label": "Container max width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "section_padding",
        "min": 40,
        "max": 120,
        "step": 10,
        "unit": "px",
        "label": "Section padding",
        "default": 80
      },
      {
        "type": "checkbox",
        "id": "enable_rounded_corners",
        "label": "Enable rounded corners",
        "default": true
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 4,
        "max": 20,
        "step": 2,
        "unit": "px",
        "label": "Border radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable scroll animations",
        "default": true,
        "info": "Animations will be disabled for users who prefer reduced motion"
      },
      {
        "type": "select",
        "id": "animation_speed",
        "label": "Animation speed",
        "options": [
          {
            "value": "slow",
            "label": "Slow"
          },
          {
            "value": "normal",
            "label": "Normal"
          },
          {
            "value": "fast",
            "label": "Fast"
          }
        ],
        "default": "normal"
      },
      {
        "type": "checkbox",
        "id": "enable_hover_effects",
        "label": "Enable hover effects",
        "default": true
      }
    ]
  },
  {
    "name": "Product Grid",
    "settings": [
      {
        "type": "range",
        "id": "products_per_row_desktop",
        "min": 2,
        "max": 5,
        "step": 1,
        "label": "Products per row (desktop)",
        "default": 4
      },
      {
        "type": "range",
        "id": "products_per_row_tablet",
        "min": 2,
        "max": 4,
        "step": 1,
        "label": "Products per row (tablet)",
        "default": 3
      },
      {
        "type": "range",
        "id": "products_per_row_mobile",
        "min": 1,
        "max": 3,
        "step": 1,
        "label": "Products per row (mobile)",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "show_product_vendor",
        "label": "Show product vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_product_rating",
        "label": "Show product rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quick_view",
        "label": "Enable quick view",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "enable_cart_notes",
        "label": "Enable cart notes",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_shipping_calculator",
        "label": "Enable shipping calculator",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_predictive_search",
        "label": "Enable predictive search",
        "default": true
      },
      {
        "type": "range",
        "id": "search_results_limit",
        "min": 4,
        "max": 20,
        "step": 2,
        "label": "Number of search results",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "search_show_products",
        "label": "Show products in search",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_collections",
        "label": "Show collections in search",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_pages",
        "label": "Show pages in search",
        "default": false
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social Media Links"
      },
      {
        "type": "url",
        "id": "social_facebook_url",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_instagram_url",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_twitter_url",
        "label": "Twitter"
      },
      {
        "type": "url",
        "id": "social_youtube_url",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_tiktok_url",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_pinterest_url",
        "label": "Pinterest"
      },
      {
        "type": "header",
        "content": "Social Sharing"
      },
      {
        "type": "checkbox",
        "id": "enable_social_sharing",
        "label": "Enable social sharing",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "share_facebook",
        "label": "Share on Facebook",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "share_twitter",
        "label": "Share on Twitter",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "share_pinterest",
        "label": "Share on Pinterest",
        "default": true
      }
    ]
  },
  {
    "name": "Newsletter",
    "settings": [
      {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Newsletter heading",
        "default": "Join the Elite"
      },
      {
        "type": "textarea",
        "id": "newsletter_description",
        "label": "Newsletter description",
        "default": "Be the first to discover new fragrances, exclusive releases, and insider stories from the world of Ignitti."
      },
      {
        "type": "text",
        "id": "newsletter_button_text",
        "label": "Button text",
        "default": "Subscribe"
      },
      {
        "type": "checkbox",
        "id": "newsletter_show_in_footer",
        "label": "Show newsletter signup in footer",
        "default": true
      }
    ]
  },
  {
    "name": "SEO",
    "settings": [
      {
        "type": "text",
        "id": "seo_title",
        "label": "Homepage title"
      },
      {
        "type": "textarea",
        "id": "seo_description",
        "label": "Homepage description"
      },
      {
        "type": "text",
        "id": "seo_keywords",
        "label": "Homepage keywords"
      },
      {
        "type": "image_picker",
        "id": "seo_image",
        "label": "Social sharing image"
      }
    ]
  },
  {
    "name": "Performance",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_lazy_loading",
        "label": "Enable lazy loading for images",
        "default": true,
        "info": "Improves page load speed by loading images only when needed"
      },
      {
        "type": "checkbox",
        "id": "enable_preloading",
        "label": "Enable critical resource preloading",
        "default": true,
        "info": "Preloads important resources for better performance"
      },
      {
        "type": "checkbox",
        "id": "minify_css",
        "label": "Minify CSS",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "minify_js",
        "label": "Minify JavaScript",
        "default": true
      }
    ]
  },
  {
    "name": "Accessibility",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_skip_links",
        "label": "Enable skip to content links",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_focus_indicators",
        "label": "Enable enhanced focus indicators",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_screen_reader_text",
        "label": "Enable screen reader text",
        "default": true
      },
      {
        "type": "range",
        "id": "minimum_contrast_ratio",
        "min": 3,
        "max": 7,
        "step": 0.5,
        "label": "Minimum contrast ratio",
        "default": 4.5,
        "info": "WCAG AA compliance requires 4.5:1"
      }
    ]
  },
  {
    "name": "Advanced",
    "settings": [
      {
        "type": "header",
        "content": "Custom Code"
      },
      {
        "type": "html",
        "id": "custom_css",
        "label": "Custom CSS"
      },
      {
        "type": "html",
        "id": "custom_js",
        "label": "Custom JavaScript"
      },
      {
        "type": "header",
        "content": "Analytics"
      },
      {
        "type": "html",
        "id": "google_analytics",
        "label": "Google Analytics code"
      },
      {
        "type": "html",
        "id": "facebook_pixel",
        "label": "Facebook Pixel code"
      },
      {
        "type": "header",
        "content": "Third-party Integrations"
      },
      {
        "type": "text",
        "id": "klaviyo_api_key",
        "label": "Klaviyo API key"
      },
      {
        "type": "text",
        "id": "mailchimp_api_key",
        "label": "Mailchimp API key"
      },
      {
        "type": "text",
        "id": "yotpo_app_key",
        "label": "Yotpo App key"
      }
    ]
  }
]
