<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Company Info -->
      <div class="footer-section company-info">
        <div class="footer-logo">
          {% if settings.logo %}
            <img src="{{ settings.logo | image_url: width: 150 }}" alt="{{ shop.name }}" class="footer-logo-image">
          {% else %}
            <span class="footer-logo-text">IGNITTI</span>
          {% endif %}
        </div>
        <p class="company-description">
          {{ section.settings.company_description | default: "Luxury candles crafted for the modern man. Elevate your space with sophisticated scents that embody confidence and refinement." }}
        </p>
        <div class="social-links">
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" class="social-link" aria-label="Facebook">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {% endif %}
          
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" class="social-link" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          {% endif %}
          
          {% if section.settings.twitter_url != blank %}
            <a href="{{ section.settings.twitter_url }}" class="social-link" aria-label="Twitter">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
          {% endif %}
          
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}" class="social-link" aria-label="YouTube">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
      
      <!-- Quick Links -->
      <div class="footer-section">
        <h3 class="footer-title">Quick Links</h3>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/collections/all">Shop All</a></li>
          <li><a href="/pages/collections">Collections</a></li>
          <li><a href="/pages/irepeat">IRepeat Subscription</a></li>
          <li><a href="/pages/about">About Us</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>
      
      <!-- Customer Care -->
      <div class="footer-section">
        <h3 class="footer-title">Customer Care</h3>
        <ul class="footer-links">
          <li><a href="/pages/shipping-info">Shipping Information</a></li>
          <li><a href="/pages/returns">Returns & Exchanges</a></li>
          <li><a href="/pages/size-guide">Candle Care Guide</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/account">My Account</a></li>
          <li><a href="/pages/track-order">Track Your Order</a></li>
        </ul>
      </div>
      
      <!-- Newsletter -->
      <div class="footer-section newsletter-section">
        <h3 class="footer-title">Stay Connected</h3>
        <p class="newsletter-description">
          {{ section.settings.newsletter_description | default: "Get exclusive access to new releases, special offers, and insider stories." }}
        </p>
        
        {% form 'customer', class: 'footer-newsletter-form' %}
          {% if form.posted_successfully? %}
            <div class="newsletter-success">
              <p>Thank you for subscribing!</p>
            </div>
          {% else %}
            <div class="newsletter-form-group">
              <input type="email" 
                     name="contact[email]" 
                     placeholder="Enter your email"
                     required
                     class="newsletter-email-input">
              <button type="submit" class="newsletter-submit-btn">
                Subscribe
              </button>
            </div>
            {% if form.errors %}
              <div class="newsletter-error">
                <p>{{ form.errors | first }}</p>
              </div>
            {% endif %}
          {% endif %}
          <input type="hidden" name="contact[tags]" value="newsletter">
        {% endform %}
      </div>
    </div>
    
    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div class="footer-bottom-content">
        <div class="copyright">
          <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
        </div>
        
        <div class="footer-legal">
          <a href="/pages/privacy-policy">Privacy Policy</a>
          <a href="/pages/terms-of-service">Terms of Service</a>
          <a href="/pages/refund-policy">Refund Policy</a>
        </div>
        
        <div class="payment-methods">
          <span class="payment-text">We Accept:</span>
          <div class="payment-icons">
            <svg width="40" height="25" viewBox="0 0 40 25" fill="none">
              <rect width="40" height="25" rx="4" fill="#1434CB"/>
              <path d="M16.5 8.5h7v8h-7v-8z" fill="#FF5F00"/>
              <circle cx="12" cy="12.5" r="4" fill="#EB001B"/>
              <circle cx="28" cy="12.5" r="4" fill="#F79E1B"/>
            </svg>
            <svg width="40" height="25" viewBox="0 0 40 25" fill="none">
              <rect width="40" height="25" rx="4" fill="#0070BA"/>
              <path d="M12 16.5c0-2.5 2-4.5 4.5-4.5s4.5 2 4.5 4.5-2 4.5-4.5 4.5-4.5-2-4.5-4.5z" fill="white"/>
              <path d="M19 16.5c0-2.5 2-4.5 4.5-4.5s4.5 2 4.5 4.5-2 4.5-4.5 4.5-4.5-2-4.5-4.5z" fill="#85C447"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(135deg, #1a1a1a 0%, #0f1419 100%);
    color: white;
    padding: 4rem 0 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .company-info {
    grid-column: span 1;
  }

  .footer-logo {
    margin-bottom: 1rem;
  }

  .footer-logo-text {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: #D4AF37;
  }

  .footer-logo-image {
    height: 35px;
    width: auto;
  }

  .company-description {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 1.5rem;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: #D4AF37;
    color: #1a1a1a;
    transform: translateY(-2px);
  }

  .footer-section {
    animation: fadeInUp 0.6s ease-out;
  }

  .footer-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    color: #D4AF37;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 0.75rem;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: #D4AF37;
  }

  .newsletter-section {
    grid-column: span 1;
  }

  .newsletter-description {
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.8;
    margin-bottom: 1.5rem;
  }

  .footer-newsletter-form {
    margin-bottom: 1rem;
  }

  .newsletter-form-group {
    display: flex;
    gap: 0.5rem;
  }

  .newsletter-email-input {
    flex: 1;
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 0.9rem;
    transition: all 0.3s ease;
  }

  .newsletter-email-input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .newsletter-email-input:focus {
    outline: none;
    border-color: #D4AF37;
    background: rgba(255, 255, 255, 0.15);
  }

  .newsletter-submit-btn {
    padding: 0.75rem 1.5rem;
    background: #D4AF37;
    color: #1a1a1a;
    border: none;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .newsletter-submit-btn:hover {
    background: #B8941F;
    transform: translateY(-1px);
  }

  .newsletter-success {
    background: rgba(76, 175, 80, 0.2);
    border: 1px solid #4CAF50;
    border-radius: 6px;
    padding: 0.75rem;
    color: #4CAF50;
    font-size: 0.9rem;
  }

  .newsletter-error {
    color: #f44336;
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
  }

  .footer-bottom-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .copyright p {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0;
  }

  .footer-legal {
    display: flex;
    gap: 1.5rem;
  }

  .footer-legal a {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-legal a:hover {
    color: #D4AF37;
  }

  .payment-methods {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .payment-text {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .payment-icons {
    display: flex;
    gap: 0.5rem;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .company-info {
      grid-column: span 1;
    }
    
    .newsletter-section {
      grid-column: span 1;
    }
    
    .newsletter-form-group {
      flex-direction: column;
    }
    
    .newsletter-submit-btn {
      width: 100%;
    }
    
    .footer-bottom-content {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
    
    .footer-legal {
      flex-wrap: wrap;
      justify-content: center;
    }
    
    .payment-methods {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .footer-container {
      padding: 0 1rem;
    }
    
    .site-footer {
      padding: 3rem 0 1rem;
    }
    
    .social-links {
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "company_description",
      "label": "Company Description",
      "default": "Luxury candles crafted for the modern man. Elevate your space with sophisticated scents that embody confidence and refinement."
    },
    {
      "type": "textarea",
      "id": "newsletter_description",
      "label": "Newsletter Description",
      "default": "Get exclusive access to new releases, special offers, and insider stories."
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    }
  ]
}
{% endschema %}
