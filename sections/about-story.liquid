<section class="about-story">
  <div class="container">
    <div class="story-content">
      <div class="story-text">
        <h2 class="section-title">{{ section.settings.heading | default: "Our Story" }}</h2>
        <div class="story-paragraphs">
          <p>
            {{ section.settings.paragraph_1 | default: "Ignitti was born from a simple observation: the candle market was dominated by floral and sweet scents, leaving discerning men without options that truly reflected their sophisticated tastes." }}
          </p>
          <p>
            {{ section.settings.paragraph_2 | default: "Founded in 2020 by master perfumer Alexander Chen, Ignitti represents a revolution in masculine fragrance. Each candle is meticulously crafted using premium soy wax and complex scent profiles that evoke confidence, luxury, and refinement." }}
          </p>
          <p>
            {{ section.settings.paragraph_3 | default: "From our workshop in Portland, Oregon, we hand-pour every candle with precision and care. Our signature scents include notes of aged whiskey, cedar, leather, tobacco, and exotic spices—creating an olfactory experience that transforms any space into a gentleman's sanctuary." }}
          </p>
        </div>
        
        <div class="story-stats">
          <div class="stat-item">
            <div class="stat-number">50K+</div>
            <div class="stat-label">Satisfied Customers</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">25</div>
            <div class="stat-label">Unique Scents</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">100%</div>
            <div class="stat-label">Natural Soy Wax</div>
          </div>
        </div>
      </div>
      
      <div class="story-images">
        <div class="image-grid">
          <div class="image-item large">
            <img src="https://pixabay.com/get/gb56a87a611ec8f3c9a9248a0859af63dfa434830d0eb4ddc9d8be2801a823fab9bcb2fc7dd867befe778821e34afbbb1d6c7b198188abe43901f10d11978af69_1280.jpg" alt="Sophisticated gentleman" loading="lazy">
          </div>
          <div class="image-item">
            <img src="https://pixabay.com/get/g37c3a9abea0f71614e74614f0a89244c4bac50e281d18334695c13702073579a95879ce4ce8c54678e27d8139debd8a70ad8c20e80a1b4f009ecd9aa2ab95c04_1280.jpg" alt="Luxury candle making" loading="lazy">
          </div>
          <div class="image-item">
            <img src="https://pixabay.com/get/g9fc0a95c03b08f7c0908c99b769bdccddd54414a51a8c984e38206ff4edbf28929d987b6eff63a2284792296404d449617ca17cd29467a803608f499d0b86c67_1280.jpg" alt="Modern masculine interior" loading="lazy">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-story {
    background-color: #1E3A2B;
    padding: 5rem 0;
    color: white;
  }

  .story-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .story-text {
    animation: fadeInLeft 0.8s ease-out;
  }

  .about-story .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #D4AF37;
  }

  .story-paragraphs p {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .story-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #D4AF37;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .story-images {
    animation: fadeInRight 0.8s ease-out;
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 2fr 1fr;
    gap: 1rem;
    height: 500px;
  }

  .image-item {
    border-radius: 12px;
    overflow: hidden;
    position: relative;
  }

  .image-item.large {
    grid-row: 1 / 3;
  }

  .image-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .image-item:hover img {
    transform: scale(1.1);
  }

  .image-item::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(26, 26, 26, 0.2);
    transition: opacity 0.3s ease;
  }

  .image-item:hover::after {
    opacity: 0;
  }

  @media (max-width: 768px) {
    .story-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .about-story .section-title {
      font-size: 2rem;
    }
    
    .story-stats {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .image-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(3, 150px);
      height: auto;
    }
    
    .image-item.large {
      grid-row: auto;
    }
  }
</style>

{% schema %}
{
  "name": "About Story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First Paragraph",
      "default": "Ignitti was born from a simple observation: the candle market was dominated by floral and sweet scents, leaving discerning men without options that truly reflected their sophisticated tastes."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second Paragraph",
      "default": "Founded in 2020 by master perfumer Alexander Chen, Ignitti represents a revolution in masculine fragrance. Each candle is meticulously crafted using premium soy wax and complex scent profiles that evoke confidence, luxury, and refinement."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Third Paragraph",
      "default": "From our workshop in Portland, Oregon, we hand-pour every candle with precision and care. Our signature scents include notes of aged whiskey, cedar, leather, tobacco, and exotic spices—creating an olfactory experience that transforms any space into a gentleman's sanctuary."
    }
  ],
  "presets": [
    {
      "name": "About Story"
    }
  ]
}
{% endschema %}
