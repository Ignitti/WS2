<section class="contact-form-section">
  <div class="container">
    <div class="contact-content">
      <div class="contact-info">
        <h2 class="section-title">{{ section.settings.heading | default: "Get in Touch" }}</h2>
        <p class="section-description">
          {{ section.settings.description | default: "Have questions about our products? Need assistance with your order? We're here to help." }}
        </p>
        
        <div class="contact-details">
          <div class="contact-item">
            <div class="contact-icon">📧</div>
            <div class="contact-text">
              <h4>Email</h4>
              <p>hello@ignitti.com</p>
            </div>
          </div>
          
          <div class="contact-item">
            <div class="contact-icon">📞</div>
            <div class="contact-text">
              <h4>Phone</h4>
              <p>+1 (555) 123-4567</p>
            </div>
          </div>
          
          <div class="contact-item">
            <div class="contact-icon">📍</div>
            <div class="contact-text">
              <h4>Address</h4>
              <p>123 Luxury Lane<br>Portland, OR 97201</p>
            </div>
          </div>
          
          <div class="contact-item">
            <div class="contact-icon">⏰</div>
            <div class="contact-text">
              <h4>Hours</h4>
              <p>Mon-Fri: 9AM-6PM PST<br>Sat-Sun: 10AM-4PM PST</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="contact-form">
        {% form 'contact', class: 'form' %}
          {% if form.posted_successfully? %}
            <div class="success-message">
              <h3>Thank you for contacting us!</h3>
              <p>We've received your message and will get back to you within 24 hours.</p>
            </div>
          {% else %}
            <div class="form-grid">
              <div class="form-group">
                <label for="contact-name">Name *</label>
                <input type="text" 
                       name="contact[name]" 
                       id="contact-name" 
                       value="{{ form.name }}"
                       required>
                {% if form.errors contains 'name' %}
                  <span class="error">{{ form.errors.translated_fields.name | capitalize }} {{ form.errors.messages.name }}</span>
                {% endif %}
              </div>
              
              <div class="form-group">
                <label for="contact-email">Email *</label>
                <input type="email" 
                       name="contact[email]" 
                       id="contact-email" 
                       value="{{ form.email }}"
                       required>
                {% if form.errors contains 'email' %}
                  <span class="error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
                {% endif %}
              </div>
              
              <div class="form-group">
                <label for="contact-phone">Phone</label>
                <input type="tel" 
                       name="contact[phone]" 
                       id="contact-phone" 
                       value="{{ form.phone }}">
              </div>
              
              <div class="form-group">
                <label for="contact-subject">Subject</label>
                <select name="contact[subject]" id="contact-subject">
                  <option value="">Select a subject</option>
                  <option value="General Inquiry" {% if form.subject == 'General Inquiry' %}selected{% endif %}>General Inquiry</option>
                  <option value="Order Support" {% if form.subject == 'Order Support' %}selected{% endif %}>Order Support</option>
                  <option value="Product Question" {% if form.subject == 'Product Question' %}selected{% endif %}>Product Question</option>
                  <option value="Subscription Help" {% if form.subject == 'Subscription Help' %}selected{% endif %}>Subscription Help</option>
                  <option value="Custom Order" {% if form.subject == 'Custom Order' %}selected{% endif %}>Custom Order</option>
                </select>
              </div>
            </div>
            
            <div class="form-group full-width">
              <label for="contact-message">Message *</label>
              <textarea name="contact[body]" 
                        id="contact-message" 
                        rows="5" 
                        required>{{ form.body }}</textarea>
              {% if form.errors contains 'body' %}
                <span class="error">{{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}</span>
              {% endif %}
            </div>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                {{ section.settings.button_text | default: "Send Message" }}
              </button>
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-form-section {
    background-color: #1a1a1a;
    padding: 5rem 0;
    color: white;
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-info {
    animation: fadeInLeft 0.8s ease-out;
  }

  .contact-form-section .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #D4AF37;
  }

  .contact-form-section .section-description {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-icon {
    font-size: 1.5rem;
    width: 40px;
    height: 40px;
    background: rgba(212, 175, 55, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-text h4 {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: #D4AF37;
  }

  .contact-text p {
    opacity: 0.8;
    line-height: 1.4;
  }

  .contact-form {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 2rem;
    animation: fadeInRight 0.8s ease-out;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-group label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #D4AF37;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.875rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #D4AF37;
    background: rgba(255, 255, 255, 0.15);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2);
  }

  .form-group select {
    cursor: pointer;
  }

  .form-group select option {
    background: #1a1a1a;
    color: white;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .error {
    color: #f44336;
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .form-actions {
    text-align: center;
  }

  .form-actions .btn {
    padding: 1rem 3rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .success-message {
    text-align: center;
    padding: 2rem;
    background: rgba(76, 175, 80, 0.2);
    border: 1px solid #4CAF50;
    border-radius: 12px;
  }

  .success-message h3 {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #4CAF50;
    margin-bottom: 0.5rem;
  }

  .success-message p {
    color: #4CAF50;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .contact-form-section .section-title {
      font-size: 2rem;
    }
    
    .form-grid {
      grid-template-columns: 1fr;
    }
    
    .contact-form {
      padding: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Have questions about our products? Need assistance with your order? We're here to help."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Send Message"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
