{% comment %}
  Main List Collections Section
  Displays all available collections in a grid layout
{% endcomment %}

<div class="list-collections section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="list-collections__header">
      {%- if section.settings.heading != blank -%}
        <h1 class="list-collections__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <div class="list-collections__description">
          <p>{{ section.settings.description }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- if collections.size > 0 -%}
        <ul class="collections-grid" role="list">
          {%- for collection in collections limit: section.settings.collections_to_show -%}
            {%- unless collection.handle == 'frontpage' -%}
              <li class="grid__item">
                <div class="collection-card">
                  <a href="{{ collection.url }}" class="collection-card__link">
                    <div class="collection-card__image">
                      {%- if collection.image -%}
                        <img
                          src="{{ collection.image | image_url: width: 400 }}"
                          alt="{{ collection.image.alt | escape }}"
                          loading="lazy"
                          width="400"
                          height="400"
                        >
                      {%- elsif collection.products.first and collection.products.first.featured_media -%}
                        <img
                          src="{{ collection.products.first.featured_media | image_url: width: 400 }}"
                          alt="{{ collection.products.first.featured_media.alt | escape }}"
                          loading="lazy"
                          width="400"
                          height="400"
                        >
                      {%- else -%}
                        <div class="collection-card__placeholder">
                          <img
                            src="https://cdn.pixabay.com/photo/2017/02/05/12/31/candle-2042085_960_720.jpg"
                            alt="Collection placeholder"
                            loading="lazy"
                            width="400"
                            height="400"
                          >
                        </div>
                      {%- endif -%}
                      
                      <div class="collection-card__overlay">
                        <a href="{{ collection.url }}" class="btn btn-secondary">View Collection</a>
                      </div>
                    </div>
                    <div class="collection-card__info">
                      <h3 class="collection-card__title">{{ collection.title }}</h3>
                      {%- if section.settings.show_collection_count -%}
                        <p class="collection-card__count">
                          {{ collection.products_count }} 
                          {%- if collection.products_count == 1 -%}
                            Product
                          {%- else -%}
                            Products
                          {%- endif -%}
                        </p>
                      {%- endif -%}
                    </div>
                  </a>
                </div>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
    {%- else -%}
      <div class="collections-empty">
        <div class="empty-state">
          <div class="empty-icon">🕯️</div>
          <h2>No Collections Found</h2>
          <p>We're currently setting up our collection pages. Check back soon for our curated candle collections.</p>
          <a href="/" class="button button--primary">Return Home</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Collections",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "collections_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 12,
      "label": "Number of collections to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_collection_count",
      "default": true,
      "label": "Show product count"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "Number of columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ]
}
{% endschema %}

<style>
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

.list-collections {
  background: linear-gradient(135deg, rgba(26, 26, 26, 0.9), rgba(30, 58, 43, 0.7));
}

.list-collections__header {
  text-align: center;
  margin-bottom: 3rem;
}

.list-collections__title {
  font-family: 'Playfair Display', serif;
  font-size: 3rem;
  font-weight: 600;
  color: #D4AF37;
  margin-bottom: 1.5rem;
  letter-spacing: 0.05em;
}

@media screen and (max-width: 749px) {
  .list-collections__title {
    font-size: 2.5rem;
  }
}

.list-collections__description {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.2rem;
  color: #cccccc;
  line-height: 1.6;
  max-width: 600px;
  margin: 0 auto;
}

.collections-grid {
  margin-top: 2rem;
}

.collections-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

@media screen and (max-width: 768px) {
  .collections-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

.collection-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  border: 1px solid rgba(255, 255, 255, 0.1);
  height: 100%;
}

.collection-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.collection-card__link {
  display: block;
  text-decoration: none;
  color: inherit;
  height: 100%;
}

.collection-card__image {
  position: relative;
  height: 250px;
  overflow: hidden;
  border-radius: 12px;
  background: rgba(30, 58, 43, 0.3);
}

.collection-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.collection-card:hover .collection-card__image img {
  transform: scale(1.1);
}

.collection-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.collection-card__placeholder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.7;
}

.collection-card__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(26, 26, 26, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  padding: 1.5rem;
}

.collection-card:hover .collection-card__overlay {
  opacity: 1;
}

.collection-card__info {
  padding: 1.5rem;
}

.collection-card__title {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.3rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #ffffff;
}

.collection-card__count {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.9rem;
  color: #D4AF37;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  text-decoration: none;
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: all 0.3s ease;
  font-size: 0.9rem;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: white;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.btn-secondary:hover {
  background: #D4AF37;
  color: #1a1a1a;
  border-color: #D4AF37;
  transform: translateY(-2px);
}

.collections-empty {
  text-align: center;
  padding: 4rem 2rem;
}

.empty-state {
  max-width: 500px;
  margin: 0 auto;
}

.empty-icon {
  font-size: 4rem;
  margin-bottom: 2rem;
}

.collections-empty h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  color: #D4AF37;
  margin-bottom: 1rem;
}

.collections-empty p {
  font-family: 'Montserrat', sans-serif;
  color: #cccccc;
  font-size: 1.1rem;
  margin-bottom: 2rem;
}

.button {
  display: inline-block;
  padding: 1rem 2rem;
  background: #D4AF37;
  color: #1a1a1a;
  text-decoration: none;
  border-radius: 8px;
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: all 0.3s ease;
}

.button:hover {
  background: #B8941F;
  transform: translateY(-2px);
}
</style>