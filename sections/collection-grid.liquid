<section class="collection-grid-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.heading | default: "Our Collections" }}</h2>
      <p class="section-description">
        {{ section.settings.description | default: "Discover our curated collections of premium candles, each designed for different moods and occasions." }}
      </p>
    </div>
    
    <div class="collections-grid">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <div class="collection-card" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 100 }}">
            <div class="collection-image">
              {% if collection.featured_image %}
                <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title }}" loading="lazy">
              {% else %}
                <img src="https://pixabay.com/get/g5659291fe9b3bf734148c00728ede866697f61509d8c10a19530315dfa872c1f02e8e06148c640c458f0a54c512b15855cfe2d01280f5e8e580ddfc022f36c50_1280.jpg" alt="{{ collection.title }}" loading="lazy">
              {% endif %}
              <div class="collection-overlay">
                <div class="collection-info">
                  <h3 class="collection-title">{{ collection.title }}</h3>
                  <p class="collection-count">{{ collection.products_count }} Products</p>
                  <a href="{{ collection.url }}" class="btn btn-primary">Explore Collection</a>
                </div>
              </div>
            </div>
          </div>
        {% endunless %}
      {% else %}
        <!-- Fallback collections when no collections exist -->
        {% assign collection_names = "The Executive Collection,Midnight Series,Vintage Leather,Smoky Whiskey" | split: "," %}
        {% assign collection_images = "https://pixabay.com/get/gfad2136b58a455806a11e97ce302661b7de94f94d4b7ec33eda41446ecce314e3939afc8419e80cc8cde7f511d921dc622987f04da41d285f77b34433b2740c7_1280.jpg,https://pixabay.com/get/g6765cbb170ac3a269ec888f4ce2f3f0dac735533a491534e5c188cdf6b23c892e2c55381898f4cfbe1ac9d137a6fd9c4be6a2cf93b1403fdb5b35bbee3f8f0c6_1280.jpg,https://pixabay.com/get/g2a460eb59f692f551041140379dee455f74b11841d9c055c6915541e4eeec5ba59bde92e7e3225d748c68cc944bea58c2d3622dba932f5e2c3636b557e072be4_1280.jpg,https://pixabay.com/get/g37c3a9abea0f71614e74614f0a89244c4bac50e281d18334695c13702073579a95879ce4ce8c54678e27d8139debd8a70ad8c20e80a1b4f009ecd9aa2ab95c04_1280.jpg" | split: "," %}
        
        {% for collection_name in collection_names %}
          <div class="collection-card" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 100 }}">
            <div class="collection-image">
              <img src="{{ collection_images[forloop.index0] }}" alt="{{ collection_name }}" loading="lazy">
              <div class="collection-overlay">
                <div class="collection-info">
                  <h3 class="collection-title">{{ collection_name }}</h3>
                  <p class="collection-count">{{ 6 | plus: forloop.index }} Products</p>
                  <a href="/collections/{{ collection_name | handleize }}" class="btn btn-primary">Explore Collection</a>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .collection-grid-section {
    background-color: #1E3A2B;
    padding: 5rem 0;
    color: white;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .collection-grid-section .section-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .collection-grid-section .section-description {
    font-size: 1.2rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .collection-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    height: 400px;
    transition: transform 0.3s ease;
  }

  .collection-card:hover {
    transform: translateY(-10px);
  }

  .collection-image {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .collection-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .collection-card:hover .collection-image img {
    transform: scale(1.1);
  }

  .collection-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.3) 0%,
      rgba(26, 26, 26, 0.8) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 2rem;
    transition: background 0.3s ease;
  }

  .collection-card:hover .collection-overlay {
    background: linear-gradient(
      to bottom,
      rgba(26, 26, 26, 0.5) 0%,
      rgba(26, 26, 26, 0.9) 100%
    );
  }

  .collection-info {
    width: 100%;
    text-align: center;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .collection-card:hover .collection-info {
    transform: translateY(0);
  }

  .collection-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .collection-count {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-bottom: 1rem;
    color: #D4AF37;
  }

  .collection-info .btn {
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease 0.1s;
  }

  .collection-card:hover .collection-info .btn {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .collection-grid-section .section-title {
      font-size: 2rem;
    }
    
    .collections-grid {
      grid-template-columns: 1fr;
    }
    
    .collection-card {
      height: 300px;
    }
    
    .collection-overlay {
      padding: 1.5rem;
    }
    
    .collection-info .btn {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our curated collections of premium candles, each designed for different moods and occasions."
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
