<section class="hero-section" style="background-image: url('{{ section.settings.background_image | image_url }}');">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="container">
      <h1 class="hero-title">{{ section.settings.heading | default: "IGNITTI" }}</h1>
      <p class="hero-subtitle">{{ section.settings.subheading | default: "Luxury Candles for the Modern Man" }}</p>
      <a href="{{ section.settings.button_link | default: "/collections/all" }}" class="btn btn-primary hero-cta">
        {{ section.settings.button_text | default: "SHOP NOW" }}
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    height: 100vh;
    background-image: url('https://pixabay.com/get/g760ccb6429162df9e33707add3f761a91736d574242bcb1220f32f20415965ff10d058bb8c8031f6fa011630a4838ab74e109e47c470d92a07f0579962cf11f6_1280.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(26, 26, 26, 0.7);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    animation: fadeInUp 1s ease-out;
  }

  .hero-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 4rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .hero-subtitle {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .hero-cta {
    font-size: 1rem;
    padding: 1rem 2rem;
    letter-spacing: 0.2em;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    
    .hero-subtitle {
      font-size: 1.2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "IGNITTI"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Luxury Candles for the Modern Man"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
