{% comment %}
  Collection Banner Section
  Displays collection title, description, and featured image
{% endcomment %}

<div class="collection-banner section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="collection-banner__content">
      {%- if collection.image -%}
        <div class="collection-banner__image">
          <img
            src="{{ collection.image | image_url: width: 1200 }}"
            alt="{{ collection.image.alt | escape }}"
            loading="lazy"
            width="1200"
            height="600"
          >
        </div>
      {%- endif -%}
      
      <div class="collection-banner__text">
        <h1 class="collection-banner__title">
          {%- if collection.title != blank -%}
            {{ collection.title | escape }}
          {%- else -%}
            {{ 'collections.general.title' | t }}
          {%- endif -%}
        </h1>
        
        {%- if collection.description != blank -%}
          <div class="collection-banner__description rte">
            {{ collection.description }}
          </div>
        {%- endif -%}
        
        {%- if collection.products_count > 0 -%}
          <p class="collection-banner__count">
            {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "Show collection description"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "Show collection image"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ]
}
{% endschema %}

<style>
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

.collection-banner {
  background: linear-gradient(135deg, rgba(26, 26, 26, 0.9), rgba(30, 58, 43, 0.7));
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.collection-banner__content {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  align-items: center;
  text-align: center;
}

@media screen and (min-width: 750px) {
  .collection-banner__content {
    grid-template-columns: 1fr 1fr;
    text-align: left;
  }
}

.collection-banner__image {
  order: 2;
  border-radius: 12px;
  overflow: hidden;
}

@media screen and (min-width: 750px) {
  .collection-banner__image {
    order: 1;
  }
}

.collection-banner__image img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.collection-banner__text {
  order: 1;
}

@media screen and (min-width: 750px) {
  .collection-banner__text {
    order: 2;
  }
}

.collection-banner__title {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem;
  font-weight: 600;
  color: #D4AF37;
  margin-bottom: 1.5rem;
  letter-spacing: 0.05em;
}

@media screen and (max-width: 749px) {
  .collection-banner__title {
    font-size: 2rem;
  }
}

.collection-banner__description {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.1rem;
  color: #cccccc;
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.collection-banner__count {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.9rem;
  color: #D4AF37;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
</style>